{
  "name": "customer-chat-system",
  "version": "2.0.0",
  "description": "Customer chat widget with location and VPN detection",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage --runInBand",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:load": "npx artillery run tests/load/artillery.yml",
    "test:load:socket": "node tests/load/socket-load-test.js",
    "test:security": "npm audit",
    "test:all": "npm run test && npm run test:e2e",
    "hash-password": "node scripts/hash-password.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "geoip-lite": "^1.4.7",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "validator": "^13.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "artillery": "^2.0.30",
    "artillery-engine-socketio-v3": "^1.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2",
    "nodemon": "^3.0.1",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "*.js",
      "src/**/*.js",
      "!coverage/**",
      "!node_modules/**",
      "!tests/**",
      "!playwright.config.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testTimeout": 10000,
    "coverageThreshold": {
      "src/**/*.js": {
        "lines": 95,
        "statements": 95,
        "functions": 95,
        "branches": 90
      }
    }
  }
}