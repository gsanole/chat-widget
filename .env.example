# Copy to .env for local dev (never commit the real .env).
# In production these are set in the Render dashboard / render.yaml.

# Node
NODE_ENV=development
PORT=3000

# Auth — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# CORS — comma-separated list of allowed origins for the embedded widget.
# In production set to your real site(s). Use * only for testing.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Reverse proxy — number of hops to trust (1 for Render, nginx, Heroku).
# Set to 0 if running directly without a proxy.
TRUST_PROXY=1

# Optional: IP Intelligence API Keys
# Uncomment and add your keys for better VPN detection

# IPQualityScore
# IPQS_API_KEY=your-ipqs-api-key

# IPInfo.io
# IPINFO_TOKEN=your-ipinfo-token

# MaxMind GeoIP2
# MAXMIND_ACCOUNT_ID=your-account-id
# MAXMIND_LICENSE_KEY=your-license-key

# lyg_hub bridge - mirror chat events to lyg_hub /inbound/chat
# Leave LYG_HUB_URL unset to disable (dev mode).
# LYG_HUB_URL=https://hub.example.com
# LYG_HUB_INBOUND_CHAT_SECRET=must-match-the-secret-on-lyg_hub-side
